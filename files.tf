# The two generated config files (spec 02e Amendments 2, 3 and 4 item 6; ledger 02e section 10.2a, section 11.0b):
#   .github/acse-gate.json    in the policies repository (gate-config-1.0), when gate.audience and gate.report_url are set
#   .github/acse-promote.json in the outbox repository   (promoter-config-1.0), for Outbox tenants
# Rendered from the merged tenant.yaml, written with the customer's own GitHub credential. ACSE never proposes them.
#
# Idempotent: generated_from (provenance) is latched to the setup commit at which the rest of the file last changed,
# so a later setup commit that leaves the content alone rewrites nothing. The runtime's drift check compares the
# file with tenant.yaml with generated_from excluded, and so does this module.
#
# Two modes (ledger 02e section 10.10; docs/decisions.md DEC-8):
#   pull_request (default) -- read the default branch's copy; if it differs from the generated one, push a branch
#                             setup-apply/<file>-<12 hex of the content> and open a pull request. Nothing is written
#                             when the default branch already matches. A merged PR's branch and PR drop out of the
#                             next plan on their own.
#   direct                 -- commit to the default branch with github_repository_file.

data "github_repository" "policies" {
  count     = local.gate_config_enabled && var.policies_default_branch == null ? 1 : 0
  full_name = tostring(local.repositories.policies)
}

resource "terraform_data" "generated_payload" {
  for_each = local.generated_files
  input    = sha256(each.value.payload_json)
}

resource "terraform_data" "generated_from" {
  for_each = local.generated_files

  input = {
    repository         = tostring(local.repositories.setup)
    commit             = var.setup_commit
    tenant_yaml_sha256 = local.tenant_yaml_sha256
  }

  lifecycle {
    ignore_changes       = [input]
    replace_triggered_by = [terraform_data.generated_payload[each.key]]
  }
}

locals {
  generated_content = {
    for key, file in local.generated_files : key => templatefile(file.template, {
      payload        = jsondecode(file.payload_json)
      generated_from = terraform_data.generated_from[key].output
    })
  }

  # The default branch's copy, generated_from excluded, re-encoded the same way as payload_json. null: missing or not
  # JSON, which is drift too.
  current_payload_json = {
    for key, file in local.generated_files : key => try(
      jsonencode({ for k, v in jsondecode(data.github_repository_file.current[key].content) : k => v if k != "generated_from" }),
      null,
    ) if var.generated_files_mode == "pull_request"
  }

  files_needing_pr = {
    for key, file in local.generated_files : key => merge(file, {
      branch = "${file.branch_stem}-${substr(sha256(file.payload_json), 0, 12)}"
    }) if var.generated_files_mode == "pull_request" && lookup(local.current_payload_json, key, null) != file.payload_json
  }
}

# -- direct --------------------------------------------------------------------------------------------------------

resource "github_repository_file" "direct" {
  for_each = var.generated_files_mode == "direct" ? local.generated_files : {}

  repository          = each.value.repository
  branch              = each.value.default_branch
  file                = each.value.path
  content             = local.generated_content[each.key]
  commit_message      = "chore(acse): generate ${each.value.path} from config/tenant.yaml\n\nGenerated by the acse-tenant module from ${local.repositories.setup}@${terraform_data.generated_from[each.key].output.commit} (${each.value.schema}). ACSE never proposes this file."
  commit_author       = try(var.commit_author.name, null)
  commit_email        = try(var.commit_author.email, null)
  overwrite_on_create = true

  depends_on = [terraform_data.tenant_config]
}

# -- pull_request --------------------------------------------------------------------------------------------------

data "github_repository_file" "current" {
  for_each = var.generated_files_mode == "pull_request" ? local.generated_files : {}

  repository = each.value.full_name
  branch     = each.value.default_branch
  file       = each.value.path
}

resource "github_branch" "generated" {
  for_each = local.files_needing_pr

  repository    = each.value.repository
  branch        = each.value.branch
  source_branch = each.value.default_branch

  depends_on = [terraform_data.tenant_config]
}

resource "github_repository_file" "on_branch" {
  for_each = local.files_needing_pr

  repository          = each.value.repository
  branch              = github_branch.generated[each.key].branch
  file                = each.value.path
  content             = local.generated_content[each.key]
  commit_message      = "chore(acse): generate ${each.value.path} from config/tenant.yaml\n\nGenerated by the acse-tenant module from ${local.repositories.setup}@${terraform_data.generated_from[each.key].output.commit} (${each.value.schema}). ACSE never proposes this file."
  commit_author       = try(var.commit_author.name, null)
  commit_email        = try(var.commit_author.email, null)
  overwrite_on_create = true
}

resource "github_repository_pull_request" "generated" {
  for_each = local.files_needing_pr

  owner                 = local.org
  base_repository       = each.value.repository
  base_ref              = each.value.default_branch
  head_ref              = github_branch.generated[each.key].branch
  title                 = "chore(acse): update ${each.value.path} from config/tenant.yaml"
  maintainer_can_modify = false
  body                  = <<-EOT
    This pull request was opened by the setup apply (`acse-tenant` module) because `${each.value.path}` on `${each.value.default_branch}` differs from the file generated from `config/tenant.yaml` in `${local.repositories.setup}` (`generated_from` is not compared).

    - Schema: `${each.value.schema}`
    - Generated from: `${local.repositories.setup}@${terraform_data.generated_from[each.key].output.commit}`, `${terraform_data.generated_from[each.key].output.tenant_yaml_sha256}`

    Merge it to make the change take effect. ACSE never proposes this file, and editing it by hand is drift: ACSE's daily check compares it with `tenant.yaml` and halts the dependent feature until they match.
  EOT

  depends_on = [github_repository_file.on_branch]
}

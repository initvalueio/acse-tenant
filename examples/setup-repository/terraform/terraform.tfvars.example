# Copy to terraform.tfvars and fill in. Nothing here is secret: the setup App's key stays in Secrets Manager, in a
# secret you name outside acse/<tenant>/.
setup_app = {
  id                     = 1000002
  installation_id        = 50000002
  private_key_secret_arn = "arn:aws:secretsmanager:ca-central-1:111122223333:secret:platform/github/acse-setup-app/private-key-GhIjKl"
}

plan_app = {
  id                     = 1000003
  installation_id        = 50000003
  private_key_secret_arn = "arn:aws:secretsmanager:ca-central-1:111122223333:secret:platform/github/acse-setup-plan-app/private-key-MnOpQr"
}

default_branches = {
  setup    = "main"
  policies = "main"
  outbox   = "main"
}

# For repositories on GitHub's immutable subject format (created after 2026-07-15), from sub_claim_prefix:
# oidc_subject_repo = { setup = "example-org@12345/acse-setup@67890", outbox = "example-org@12345/acse-outbox@67891" }

bootstrap_admin_role_arns = ["arn:aws:iam::111122223333:role/platform-break-glass"]

apply_environment_reviewers = {
  users = []
  teams = [1234567]
}

other_bot_app_ids   = []
ruleset_enforcement = "evaluate"

# Optional permissions: opt in to reads ACSE's setup never requests. Empty grants nothing more; without one, only the
# checks it unlocks read "Not judged: needs permission X (not requested by setup)". Uncomment what you want, merge, and
# the setup pipeline (acse-setup-apply.yml) applies it.
#
#   aws   "macie2:GetMacieSession"                                              -> aws-macie-enabled
#         (granted here: one inline policy, acse-optional-reads, on ACSEReadOnlyScanner in this account)
#   gcp   "policyanalyzer.serviceAccountKeyLastAuthenticationActivities.query" -> gcp-iam-sa-key-unused
#   azure "Graph:AuditLog.Read.All"                                             -> azure-entra-vm-access-users-mfa,
#                                                                                  azure-entra-users-mfa
#   azure "Graph:RoleManagement.Read.Directory"                                 -> (no check reads it yet)
#   azure "Microsoft.Authorization/roleAssignments/read at /"                   -> azure-rbac-user-access-admin-restricted
#         (GCP and Azure: recorded and validated here; granted by you in that cloud until the module grants them, DEC-49)
optional_permissions = {
  # aws   = ["macie2:GetMacieSession"]
  # gcp   = ["policyanalyzer.serviceAccountKeyLastAuthenticationActivities.query"]
  # azure = ["Graph:AuditLog.Read.All"]
}
